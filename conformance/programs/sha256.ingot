//! expect: run
//! section: 4.5, 5.2, 7.1, 31

// SHA-256 (FIPS 180-4) of two literals, compared with their published digests: wrapping
// arithmetic, shifts, arrays, `for` loops, a constant table, and check removal in the
// compression loop.

import std.Env;

const k: [64]u32 = [64]u32.{
    0x428a2f98,
    0x71374491,
    0xb5c0fbcf,
    0xe9b5dba5,
    0x3956c25b,
    0x59f111f1,
    0x923f82a4,
    0xab1c5ed5,
    0xd807aa98,
    0x12835b01,
    0x243185be,
    0x550c7dc3,
    0x72be5d74,
    0x80deb1fe,
    0x9bdc06a7,
    0xc19bf174,
    0xe49b69c1,
    0xefbe4786,
    0x0fc19dc6,
    0x240ca1cc,
    0x2de92c6f,
    0x4a7484aa,
    0x5cb0a9dc,
    0x76f988da,
    0x983e5152,
    0xa831c66d,
    0xb00327c8,
    0xbf597fc7,
    0xc6e00bf3,
    0xd5a79147,
    0x06ca6351,
    0x14292967,
    0x27b70a85,
    0x2e1b2138,
    0x4d2c6dfc,
    0x53380d13,
    0x650a7354,
    0x766a0abb,
    0x81c2c92e,
    0x92722c85,
    0xa2bfe8a1,
    0xa81a664b,
    0xc24b8b70,
    0xc76c51a3,
    0xd192e819,
    0xd6990624,
    0xf40e3585,
    0x106aa070,
    0x19a4c116,
    0x1e376c08,
    0x2748774c,
    0x34b0bcb5,
    0x391c0cb3,
    0x4ed8aa4a,
    0x5b9cca4f,
    0x682e6ff3,
    0x748f82ee,
    0x78a5636f,
    0x84c87814,
    0x8cc70208,
    0x90befffa,
    0xa4506ceb,
    0xbef9a3f7,
    0xc67178f2,
};

fn rotr(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n));
}

/// One 64-byte block of `data`, starting at `at`, folded into `h`.
fn compress(h: &mut [8]u32, data: &[128]u8, at: i64) {
    var w: [64]u32 = @zero;
    for t in 0..16 {
        let i = at + t * 4;
        w[t] = (data[i] as u32 << 24)
            | (data[i + 1] as u32 << 16)
            | (data[i + 2] as u32 << 8)
            | data[i + 3] as u32;
    }
    for t in 16..64 {
        let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3);
        let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10);
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];
    for t in 0..64 {
        let big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        let ch = (e & f) ^ (~e & g);
        let t1 = hh +% big1 +% ch +% k[t] +% w[t];
        let big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = big0 +% maj;
        hh = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
    }
    h[0] = h[0] +% a;
    h[1] = h[1] +% b;
    h[2] = h[2] +% c;
    h[3] = h[3] +% d;
    h[4] = h[4] +% e;
    h[5] = h[5] +% f;
    h[6] = h[6] +% g;
    h[7] = h[7] +% hh;
}

/// The digest of a message of at most 119 bytes: it pads into one or two blocks.
fn digest(msg: []u8) -> [8]u32 {
    @assert(msg.len <= 119);
    var data: [128]u8 = @zero;
    for i, byte in msg {
        data[i] = byte;
    }
    data[msg.len] = 0x80;
    let blocks: i64 = if msg.len + 9 <= 64 { 1 } else { 2 };
    let bits: u64 = @wrap(u64, msg.len) * 8;
    let end = blocks * 64;
    for j in 0..8 {
        data[end - 1 - j] = @wrap(u8, bits >> @wrap(u64, j * 8));
    }
    var h: [8]u32 = [8]u32.{
        0x6a09e667,
        0xbb67ae85,
        0x3c6ef372,
        0xa54ff53a,
        0x510e527f,
        0x9b05688c,
        0x1f83d9ab,
        0x5be0cd19,
    };
    for blk in 0..blocks {
        compress(&mut h, &data, blk * 64);
    }
    return h;
}

fn same(a: [8]u32, b: [8]u32) -> bool {
    for i in 0..8 {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

pub fn main(env: &Env) -> u8 {
    let one = digest("abc");
    @assert(
        same(
            one,
            [8]u32.{
                0xba7816bf,
                0x8f01cfea,
                0x414140de,
                0x5dae2223,
                0xb00361a3,
                0x96177a9c,
                0xb410ff61,
                0xf20015ad,
            },
        ),
    );
    let two = digest(
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    );
    @assert(
        same(
            two,
            [8]u32.{
                0x248d6a61,
                0xd20638b8,
                0xe5c02693,
                0x0c3e6039,
                0xa33ce459,
                0x64ff2167,
                0xf6ecedd4,
                0x19db06c1,
            },
        ),
    );
    let empty = digest("");
    @assert(
        same(
            empty,
            [8]u32.{
                0xe3b0c442,
                0x98fc1c14,
                0x9afbf4c8,
                0x996fb924,
                0x27ae41e4,
                0x649b934c,
                0xa495991b,
                0x7852b855,
            },
        ),
    );
    return 0;
}
