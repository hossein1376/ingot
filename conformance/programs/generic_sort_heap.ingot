//! expect: run
//! section: 4.4, 5.6, 8

// A generic insertion sort with a closure comparator, a generic heap sort through
// `Ord`, and a generic fixed-capacity max-heap, each used at two element types (`i64`
// and a struct with its own `Ord`): instances, calls through bounds, closures that
// capture by value and by `&mut`, and `?T` results.

import std.Env;

copy struct Pt {
    x: i64,
    y: i64,
}

impl Eq for Pt {
    fn eq(self: &Self, other: &Self) -> bool {
        return self.x == other.x && self.y == other.y;
    }
}

impl Ord for Pt {
    fn cmp(self: &Self, other: &Self) -> Ordering {
        if self.x < other.x {
            return .less;
        }
        if self.x > other.x {
            return .greater;
        }
        if self.y < other.y {
            return .less;
        }
        if self.y > other.y {
            return .greater;
        }
        return .equal;
    }
}

fn is_greater(o: Ordering) -> bool {
    match o {
        .greater => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn swap[T: Copy](xs: []mut T, i: i64, j: i64) {
    let t = xs[i];
    xs[i] = xs[j];
    xs[j] = t;
}

/// Sorts so that `before(a, b)` never holds for a later `a` and an earlier `b`.
fn insertion_sort_by[T: Copy, F: FnMut(&T, &T) -> bool](xs: []mut T, before: F) {
    for i in 1..xs.len {
        var j = i;
        while j > 0 && before(&xs[j], &xs[j - 1]) {
            swap(xs, j, j - 1);
            j -= 1;
        }
    }
}

fn sift_down[T: Copy + Ord](xs: []mut T, start: i64, end: i64) {
    var root = start;
    while root * 2 + 1 < end {
        var child = root * 2 + 1;
        if child + 1 < end && is_greater(xs[child + 1].cmp(&xs[child])) {
            child += 1;
        }
        if !is_greater(xs[child].cmp(&xs[root])) {
            return;
        }
        swap(xs, root, child);
        root = child;
    }
}

fn heap_sort[T: Copy + Ord](xs: []mut T) {
    let n = xs.len;
    var start = n / 2;
    while start > 0 {
        start -= 1;
        sift_down(xs, start, n);
    }
    var end = n;
    while end > 1 {
        end -= 1;
        swap(xs, 0, end);
        sift_down(xs, 0, end);
    }
}

fn is_sorted[T: Ord](xs: []T) -> bool {
    for i in 1..xs.len {
        if is_greater(xs[i - 1].cmp(&xs[i])) {
            return false;
        }
    }
    return true;
}

/// A max-heap in a fixed array, filled from the front.
struct MaxHeap[T, const n: i64] {
    items: [n]T,
    len: i64,
}

impl[T: Copy + Ord, const n: i64] MaxHeap[T, n] {
    fn push(self: &mut Self, x: T) {
        @assert(self.len < n);
        var at = self.len;
        self.items[at] = x;
        self.len += 1;
        while at > 0 {
            let parent = (at - 1) / 2;
            if !is_greater(self.items[at].cmp(&self.items[parent])) {
                return;
            }
            let t = self.items[at];
            self.items[at] = self.items[parent];
            self.items[parent] = t;
            at = parent;
        }
    }

    fn pop(self: &mut Self) -> ?T {
        if self.len == 0 {
            return .none;
        }
        let top = self.items[0];
        self.len -= 1;
        self.items[0] = self.items[self.len];
        sift_down(&mut self.items[0..self.len], 0, self.len);
        return .some(top);
    }
}

fn check_ints() {
    var xs: [9]i64 = [9]i64.{ 5, -3, 9, 0, 9, 2, -8, 7, 1 };
    heap_sort(&mut xs[0..9]);
    @assert(is_sorted(&xs[0..9]));
    @assert(xs[0] == -8 && xs[8] == 9);

    var ys: [6]i64 = [6]i64.{ 4, 1, 6, 2, 5, 3 };
    let pivot: i64 = 0;
    var comparisons: i64 = 0;
    insertion_sort_by(&mut ys[0..6], fn [pivot, &mut comparisons](a: &i64, b: &i64) -> bool {
        comparisons.* += 1;
        return a.* - pivot > b.* - pivot;
    });
    @assert(ys[0] == 6 && ys[5] == 1);
    @assert(comparisons > 0);

    var heap = MaxHeap[i64, 8].{ items: [8]i64.{ 0, 0, 0, 0, 0, 0, 0, 0 }, len: 0 };
    heap.push(3);
    heap.push(11);
    heap.push(-2);
    heap.push(7);
    let first = heap.pop() orelse -100;
    @assert(first == 11);
    let second = heap.pop() orelse -100;
    @assert(second == 7);
}

fn check_points() {
    var ps: [5]Pt = [5]Pt.{
        Pt.{ x: 2, y: 1 },
        Pt.{ x: 1, y: 9 },
        Pt.{ x: 2, y: 0 },
        Pt.{ x: 0, y: 4 },
        Pt.{ x: 1, y: 2 },
    };
    heap_sort(&mut ps[0..5]);
    @assert(is_sorted(&ps[0..5]));
    @assert(ps[0].x == 0 && ps[4].x == 2 && ps[4].y == 1);

    insertion_sort_by(&mut ps[0..5], fn [](a: &Pt, b: &Pt) -> bool { return a.y < b.y; });
    @assert(ps[0].y == 0 && ps[4].y == 9);

    let zero = Pt.{ x: 0, y: 0 };
    var heap = MaxHeap[Pt, 4].{ items: [4]Pt.{ zero, zero, zero, zero }, len: 0 };
    heap.push(Pt.{ x: 1, y: 1 });
    heap.push(Pt.{ x: 3, y: 0 });
    heap.push(Pt.{ x: 3, y: 5 });
    let top = heap.pop() orelse zero;
    @assert(top.x == 3 && top.y == 5);
    let next = heap.pop() orelse zero;
    @assert(next.x == 3 && next.y == 0);
    let last = heap.pop() orelse zero;
    @assert(last.x == 1);
    let none = heap.pop() orelse zero;
    @assert(none.x == 0 && none.y == 0);
}

pub fn main(env: &Env) -> u8 {
    check_ints();
    check_points();
    return 0;
}
