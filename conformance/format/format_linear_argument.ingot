//! expect: accept
//! section: 35

linear struct L { x: i64 }

// An argument of `@debug` is read through a shared borrow, not moved: `l` is printed
// twice and still consumed once afterwards.
fn f(l: L) {
    @debug("{}", l);
    @debug("{}", l);
    consume(l);
}

fn consume(l: L) {
    let L.{ x } = l;
    _ = x;
}
