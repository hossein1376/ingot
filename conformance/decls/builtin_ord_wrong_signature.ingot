//! expect: reject
//! section: 4.4

struct Money {
    cents: i64,
}

impl Eq for Money {
    fn eq(self: &Money, other: &Money) -> bool {
        return self.cents == other.cents;
    }
}

impl Ord for Money {
    fn cmp(self: &Money, other: &Money) -> bool { //~ E0509
        return self.cents < other.cents;
    }
}
