//! expect: reject
//! section: 4.4

interface Measure {
    fn measure(self: &Self) -> i64;
}

struct Square { side: i64 }

impl Measure for Square {
    fn measure(self: &Square) -> i64 {
        return self.side;
    }

    fn area(self: &Square) -> i64 { //~ E0509
        return self.side * self.side;
    }
}
