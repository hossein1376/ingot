//! expect: reject
//! section: 13.2

struct Lexer {
    src: []u8,
    pos: i64,
}

fn set_input(l: &mut Lexer, text: []u8 into l) {
    l.src = text;
    l.pos = 0;
}

fn f(a: []u8) -> i64 {
    var lx = Lexer.{ src: a, pos: 0 };
    {
        let local: [4]u8 = @zero;
        set_input(&mut lx, &local[0..4]); //~ E1105
    }
    return lx.src.len;
}
