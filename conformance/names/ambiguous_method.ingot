//! expect: reject
//! section: 4.4

interface Area {
    fn size(self: &Self) -> i64;
}

interface Volume {
    fn size(self: &Self) -> i64;
}

struct Block {
    side: i64,
}

impl Area for Block {
    fn size(self: &Block) -> i64 {
        return self.side * self.side;
    }
}

impl Volume for Block {
    fn size(self: &Block) -> i64 {
        return self.side * self.side * self.side;
    }
}

fn measure(b: &Block) -> i64 {
    return b.size(); //~ E0313
}
