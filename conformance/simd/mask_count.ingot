//! expect: run
//! section: 26

import std.Env;

pub fn main(env: &Env) -> u8 {
    let bytes: [16]u8 = [16]u8.{
        10,
        7,
        10,
        1,
        2,
        10,
        3,
        4,
        5,
        6,
        10,
        8,
        9,
        0,
        10,
        10,
    };
    let v = @load(u8x16, &bytes[0..16], 0);
    let hits = @count(v == @splat(u8x16, 10));
    @assert(hits == 6);
    return 0;
}
