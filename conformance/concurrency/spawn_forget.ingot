//! expect: run
//! section: 18

import std.Env;

fn bump(x: &mut i64) {
    x.* += 1;
}

pub fn main(env: &Env) -> u8 {
    var total: i64 = 0;
    scope s {
        // A handle that is forgotten is never joined; the scope's wait still runs the
        // task, and its effect is visible after the block.
        let h = spawn bump(&mut total) in s;
        @forget(h);
    }
    @assert(total == 1);
    return 0;
}
