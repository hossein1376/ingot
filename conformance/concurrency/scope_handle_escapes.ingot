//! expect: reject
//! section: 18

import std.task.Scope;
import std.task.Task;

fn one() -> i64 {
    return 1;
}

fn start(s: &Scope) -> Task[i64] from s {
    return spawn one() in s;
}

fn outer2() -> Task[i64] from static {
    scope s {
        let h = start(s);
        return h; //~ E1203
    }
}
