//! expect: accept
//! section: 5.6

fn apply[F: Fn(i64) -> i64](f: F) -> i64 {
    return f(1);
}

fn apply_mut[F: FnMut(i64) -> i64](f: F) -> i64 {
    return f(1);
}

fn f(x: i64) -> i64 {
    let shared = fn [&x](a: i64) -> i64 { return a + x.*; };
    let copied = fn [](a: i64) -> i64 { return a; };
    var y = 1;
    let exclusive = fn [&mut y](a: i64) -> i64 {
        y.* += a;
        return y.*;
    };
    _ = apply(shared);
    _ = apply(copied);
    _ = apply_mut(exclusive);
    return 0;
}
