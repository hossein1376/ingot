//! expect: run
//! section: 3, 7

import std.Env;

fn maybe(ok: bool) -> ?[4]i64 {
    if ok {
        return .some([4]i64.{ 1, 2, 3, 4 });
    }
    return .none;
}

pub fn main(env: &Env) -> u8 {
    match maybe(true) {
        .some(a) => { @assert(a[3] == 4); }
        .none => { @assert(false); }
    }
    match maybe(false) {
        .some(_) => { @assert(false); }
        .none => {}
    }
    return 0;
}
