//! expect: run
//! section: 5.4

import std.Env;

pub fn main(env: &Env) -> u8 {

    let big: i64 = 300;
    @assert(@wrap(u8, big) == 44);
    @assert(@sat(u8, big) == 255);
    @assert(@sat(i8, -big) == -128);
    @assert(@narrow(i16, big) == 300);
    let small: u8 = 200;
    @assert(small as i64 == 200);
    @assert(@nearest(f32, big) == 300.0);
    @assert(@sat(i32, 1.0e20) == 2147483647);
    let one: f32 = 1.0;
    @assert(@bits(u32, one) == 0x3f80_0000);
    return 0;
}
