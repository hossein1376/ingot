//! expect: run
//! section: 5.7

import std.Env;

fn sum_range(lo: i64, hi: i64) -> i64 {
    var total: i64 = 0;
    for i in lo..hi {
        total += i;
    }
    return total;
}

fn sum_slice(xs: []i64) -> i64 {
    var total: i64 = 0;
    for i, x in xs {
        total += x + i;
    }
    return total;
}

fn sum_array(xs: [3]i64) -> i64 {
    var total: i64 = 0;
    for x in xs {
        total += x;
    }
    return total;
}

pub fn main(env: &Env) -> u8 {
    @assert(sum_range(0, 5) == 10);
    let xs: [4]i64 = [4]i64.{ 1, 2, 3, 4 };
    @assert(sum_slice(&xs[0..4]) == 16);
    @assert(sum_array([3]i64.{ 2, 4, 6 }) == 12);
    return 0;
}
