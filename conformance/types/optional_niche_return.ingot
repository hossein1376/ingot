//! expect: run
//! section: 3, 7

import std.Env;

fn maybe_slice(ok: bool) -> ?[]u8 from static {
    if ok {
        return .some("abc");
    }
    return .none;
}

fn maybe_ref(ok: bool, p: &i64) -> ?&i64 from p {
    if ok {
        return .some(p);
    }
    return .none;
}

pub fn main(env: &Env) -> u8 {
    match maybe_slice(true) {
        .some(s) => { @assert(s.len == 3); }
        .none => { @assert(false); }
    }
    match maybe_slice(false) {
        .some(_) => { @assert(false); }
        .none => {}
    }
    let n: i64 = 9;
    match maybe_ref(true, &n) {
        .some(p) => { @assert(p.* == 9); }
        .none => { @assert(false); }
    }
    match maybe_ref(false, &n) {
        .some(_) => { @assert(false); }
        .none => {}
    }
    return 0;
}
