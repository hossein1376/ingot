//! expect: run
//! section: 3, 7, 25

import std.Env;

fn read_ref(o: ?&i64) -> i64 {
    match o {
        .some(p) => { return p.*; }
        .none => { return -1; }
    }
}

fn read_slice(o: ?[]u8) -> i64 {
    match o {
        .some(s) => { return s.len; }
        .none => { return -1; }
    }
}

pub fn main(env: &Env) -> u8 {
    let n: i64 = 42;
    let some_ref: ?&i64 = .some(&n);
    @assert(read_ref(some_ref) == 42);
    let no_ref: ?&i64 = .none;
    @assert(read_ref(no_ref) == -1);
    let some_slice: ?[]u8 = .some("abc");
    @assert(read_slice(some_slice) == 3);
    let no_slice: ?[]u8 = .none;
    @assert(read_slice(no_slice) == -1);
    return 0;
}
