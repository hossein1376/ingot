//! expect: cost
//! section: 15, 31

fn g(xs: []i64, short: []i64, i: i64) -> i64 {
    var s = xs;
    let q = &mut s as *mut []i64;
    if i >= 0 {
        if i < s.len {
            unsafe("q writes s") {
                q.* = short;
            }
            return s[i]; //~ bounds_check
        }
    }
    return 0;
}
