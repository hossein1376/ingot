//! expect: accept
//! section: 1, 8

struct Buf[const n: i64] {
    data: [n + 1]u8,
}

fn take[const m: i64](b: Buf[m]) -> [m + 1]u8 {
    return b.data;
}

fn same[const n: i64](x: [n + 1]u8) -> [n + 1]u8 {
    return x;
}

fn call() -> i64 {
    let b = Buf[3].{ data: @zero([4]u8) };
    let x = take(b);
    let y = same.[3](@zero([4]u8));
    @forget(x);
    @forget(y);
    return 0;
}
