//! expect: run
//! section: 6

import std.Env;

enum HalfErr { odd }

fn half(n: i64) -> i64 ! HalfErr {
    if n % 2 != 0 { fail .odd; }
    return n / 2;
}

fn quarter(n: i64) -> i64 ! HalfErr {
    let h = try half(n);
    return try half(h);
}

pub fn main(env: &Env) -> u8 {
    let a = quarter(8) catch _ => -1;
    @assert(a == 2);
    let b = quarter(6) catch _ => -1;
    @assert(b == -1);
    return 0;
}
