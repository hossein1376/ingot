//! expect: run
//! section: 4.3, 6.3, 7

import std.Env;

struct OkPay { a: i64, b: i64 }

struct ErrPay { x: i64, y: i64, z: i64 }

enum E { bad: ErrPay }

fn value(ok: bool) -> OkPay ! E {
    if !ok {
        fail .bad(ErrPay.{ x: 3, y: 4, z: 5 });
    }
    return OkPay.{ a: 1, b: 2 };
}

fn on_err(e: E) -> OkPay {
    match e {
        .bad(p) => {
            return OkPay.{ a: p.z, b: 0 };
        }
    }
}

pub fn main(env: &Env) -> u8 {
    let a = value(true) catch _ => OkPay.{ a: -1, b: -1 };
    @assert(a.a == 1 && a.b == 2);
    let b = value(false) catch e => on_err(e);
    @assert(b.a == 5);
    match value(true) {
        .ok(v) => {
            @assert(v.a == 1);
        }
        .err(_) => {
            @assert(false);
        }
    }
    match value(false) {
        .ok(_) => {
            @assert(false);
        }
        .err(e) => {
            match e {
                .bad(p) => {
                    @assert(p.x == 3 && p.y == 4);
                }
            }
        }
    }
    return 0;
}
