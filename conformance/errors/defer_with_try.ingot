//! expect: run
//! section: 6.4

import std.Env;

enum E {
    bad,
}

fn low(ok: bool) -> i64 ! E {
    if !ok {
        fail .bad;
    }
    return 7;
}

fn mid(ok: bool, log: &mut [4]i64, at: &mut i64) -> i64 ! E {
    defer {
        log[at.*] = 10;
        at.* += 1;
    }
    errdefer {
        log[at.*] = 20;
        at.* += 1;
    }
    let v = try low(ok);
    return v;
}

pub fn main(env: &Env) -> u8 {
    var log: [4]i64 = @zero;
    var at: i64 = 0;
    let a = mid(true, &mut log, &mut at) catch _ => -1;
    @assert(a == 7);
    @assert(at == 1);
    @assert(log[0] == 10);

    at = 0;
    let b = mid(false, &mut log, &mut at) catch _ => -1;
    @assert(b == -1);
    @assert(at == 2);
    @assert(log[0] == 20);
    @assert(log[1] == 10);
    return 0;
}
