//! expect: run
//! exit: 1
//! stderr: error: E.bad(7)
//! section: 6, 33.1

// `try` on calls whose success type is `void`: the first succeeds, the second fails
// and its error reaches `main`.

import std.Env;

enum E {
    bad: i64,
}

fn step(n: i64) -> void ! E {
    if n > 2 {
        fail .bad(n);
    }
}

pub fn main(env: &Env) -> void ! E {
    try step(1);
    try step(7);
}
