pub linear struct Token {
    id: i32,
}

impl Token {
    pub fn make(id: i32) -> Token {
        return Token.{ id: id };
    }
    pub fn release(self: Token) {
        let Token.{ id: _ } = self;
    }
}

pub linear struct Box {
    pub t: Token,
    n: i64,
}

pub fn make() -> Box {
    return Box.{ t: Token.make(1), n: 0 };
}
