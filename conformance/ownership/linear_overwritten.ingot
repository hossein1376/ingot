//! expect: reject
//! section: 11

linear struct Token {
    id: i32,
}

impl Token {
    fn make(id: i32) -> Token {
        return Token.{ id: id };
    }
    fn release(self: Token) {
        let Token.{ id: _ } = self;
    }
}

fn f() {
    var t = Token.make(1);
    t = Token.make(2); //~ E1004
    t.release();
}
