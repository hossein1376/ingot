interface Named {
    fn name(self: &Self) -> i64;
}

struct Item { n: i64 }

impl Named for Item {
    fn name(self: &Item) -> i64 {
        return self.n;
    }
}

impl Item {
    fn unused(self: &Item) -> i64 {
        return self.n;
    }
}

fn by_bound[T: Named](x: &T) -> i64 {
    return x.name();
}

fn by_dyn(x: &dyn Named) -> i64 {
    return x.name();
}

fn run() -> i64 {
    let item = Item.{ n: 3 };
    let a = Named.name(&item);
    let b = by_bound(&item);
    let c = by_dyn(&item);
    return a + b + c;
}
