// control flow: if as a statement and a value, while, loop, break and continue

fn f(n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < n {
        i += 1;
        if i == 2 {
            continue;
        }
        if i == 5 {
            break;
        }
        total += i;
    }
    loop {
        if total > 100 {
            break;
        }
        total += 10;
    }
    let sign: i64 = if total < 0 { return 0; } else if total == 0 { 0 } else { 1 };
    outer: for a in 0..3 {
        for b in 0..3 {
            if a == b { continue outer; }
            if a > b { break outer; }
            total += a + b;
        }
    }
    if sign == 1 {
        total += 1;
    } else {
        total -= 1;
    }
    return total;
}
