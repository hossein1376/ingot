// evaluation order: the target's indices, then the value, then the checks, then the
// store; a compound assignment reads the place after the value

fn f(x: i64) -> i64 {
    return x + 1;
}

fn g(a: []mut i64, j: i64) -> i64 {
    return a[j];
}

fn assign(a: []mut i64, i: i64, j: i64) {
    a[i] = f(a[j]);
    a[i] += g(a, j);
}
