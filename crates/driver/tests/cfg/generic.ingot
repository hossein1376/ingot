// a generic body lowered once, uninstantiated, with a constant parameter

fn sum[T: Num](xs: []T) -> T {
    var s: T = @zero;
    for x in xs {
        s = s + x;
    }
    return s;
}

struct Ring[T, const n: i64] {
    items: [n]T,
    head: i64,
}

fn first[T: Copy, const n: i64](r: &Ring[T, n]) -> T {
    return r.items[0];
}

fn count[T, const n: i64](xs: &[n]T) -> i64 {
    var i: i64 = 0;
    while i < n {
        i += 1;
    }
    return i;
}
