// std.list (docs/std/list.md): the growable array.

import std.mem.AllocErr;
import std.mem.AllocFail;
import std.mem.Allocator;
import std.mem.Arena;
import std.mem.Heap;
import std.mem.eq;

/// The largest byte size of a block, and so of a list (mem.md section 2).
const max_bytes: i64 = 4611686018427387904;

/// The most elements of `T` a list may have room for: the elements fill at most `2^62`
/// bytes, and a list of zero-sized elements counts up to `2^62` of them (a slice of
/// them cannot be longer).
fn max_elems[T]() -> i64 {
    let size = @sizeof(T);
    if size == 0 {
        return max_bytes;
    }
    return max_bytes / size;
}

/// The pointer of a list that holds no block: the alignment of `T` as an address, which
/// is non-null and aligned, and which nothing reads or writes through.
fn dangling[T]() -> *mut T {
    return @wrap(u64, @alignof(T)) as *mut T;
}

/// Moves the value out of the slot `p[i]`, which is then uninitialized.
///
/// Precondition: `p[i]` is inside the list's block and holds a live `T`, and the caller
/// never reads or drops that slot again before writing it.
unsafe fn load[T](p: *mut T, i: i64) -> T {
    unsafe("p[i] holds a live T, and the caller treats the slot as empty from here on") {
        return @offset(p, i).*;
    }
}

/// Writes `value` into the slot `p[i]` without dropping what was there.
///
/// Precondition: `p[i]` is inside the list's block, aligned for `T`, and holds no live
/// value (it is past the length or has just been moved out), and nothing refers to it.
unsafe fn store[T](p: *mut T, i: i64, value: T) -> void {
    unsafe("p[i] is an empty slot inside the block, aligned for T, and nothing refers to it") {
        @offset(p, i).* = value;
    }
}

/// Moves the `n` values at `src` to `dst`, first to last. The slots at `src` are empty
/// afterwards. A zero-sized `T` has no bytes to move, so the loop is skipped.
///
/// Precondition: both blocks hold at least `n` slots of `T`, `src[0..n]` are live,
/// `dst[0..n]` are empty, and the two ranges do not overlap.
unsafe fn move_all[T](src: *mut T, dst: *mut T, n: i64) -> void {
    if @sizeof(T) == 0 {
        return;
    }
    var i: i64 = 0;
    while i < n {
        unsafe("src[i] is live and dst[i] is empty for every i < n, in two blocks that do not overlap") {
            store(dst, i, load(src, i));
        }
        i += 1;
    }
}

/// Moves `p[at..n]` up by one slot, last first, leaving `p[at]` empty.
///
/// Precondition: `0 <= at <= n`, `p[at..n]` are live and `p[n]` is an empty slot of the
/// same block.
unsafe fn shift_up[T](p: *mut T, at: i64, n: i64) -> void {
    if @sizeof(T) == 0 {
        return;
    }
    var j = n;
    while j > at {
        unsafe("p[j - 1] is live and p[j] is empty, both inside the block, for each j from n down to at + 1") {
            store(p, j, load(p, j - 1));
        }
        j -= 1;
    }
}

/// Moves `p[at + 1..n]` down by one slot, first first, into the empty slot `p[at]`;
/// `p[n - 1]` is empty afterwards.
///
/// Precondition: `0 <= at < n`, `p[at]` is empty and `p[at + 1..n]` are live.
unsafe fn shift_down[T](p: *mut T, at: i64, n: i64) -> void {
    if @sizeof(T) == 0 {
        return;
    }
    var j = at;
    while j < n - 1 {
        unsafe("p[j + 1] is live and p[j] is empty, both inside the block, for each j from at up to n - 2") {
            store(p, j, load(p, j + 1));
        }
        j += 1;
    }
}

/// Gives the list's block of `cap` slots back to `a`, once its elements are gone. A block
/// of no bytes is not given back: it may be the list's own `dangling` pointer, which did
/// not come from `a`, and freeing a size-0 block does nothing anyway (mem.md section 2).
///
/// Precondition: `ptr` is the list's block of `cap` slots, allocated from `a` (or, when it
/// has no bytes, `dangling`), no live element is left in it that needs consuming, and
/// nothing uses it afterwards.
unsafe fn free_block[T, A: Allocator](a: A, ptr: *mut T, cap: i64) -> void {
    let bytes = cap * @sizeof(T);
    if bytes == 0 {
        return;
    }
    unsafe("the caller's precondition: the block of cap slots came from a with this size and align, and nothing uses it after") {
        a.free(ptr as *mut u8, bytes, @alignof(T));
    }
}

/// A growable array. Linear: it owns its memory, so `deinit` or `deinit_with` is
/// required. A view of whatever `T` and `A` borrow.
///
/// `ptr` is the block, `n` the length and `cap` the capacity, both in elements, with
/// `0 <= n <= cap <= max_elems[T]()`; `ptr[0..n]` are live and `ptr[n..cap]` are empty. A
/// list that has never allocated has `cap == 0` and `ptr` is `dangling`.
pub linear struct List[T, A: Allocator] {
    a: A,
    ptr: *mut T,
    n: i64,
    cap: i64,
}

impl[T, A: Allocator] List[T, A] {
    /// An empty list. Allocates nothing, so it cannot fail.
    pub fn init(a: A) -> List[T, A] {
        return List[T, A].{ a: a, ptr: dangling.[T](), n: 0, cap: 0 };
    }

    /// An empty list with room for `n` elements. A negative `n`, or a byte size above
    /// 2^62, is `.bad_request`.
    pub fn with_capacity(a: A, n: i64) -> List[T, A] ! AllocErr {
        if n < 0 || n > max_elems.[T]() {
            fail .bad_request;
        }
        let block = try a.alloc(n * @sizeof(T), @alignof(T));
        return List[T, A].{ a: a, ptr: block as *mut T, n: 0, cap: n };
    }

    pub fn len(self: &List[T, A]) -> i64 {
        return self.n;
    }

    pub fn capacity(self: &List[T, A]) -> i64 {
        return self.cap;
    }

    pub fn is_empty(self: &List[T, A]) -> bool {
        return self.n == 0;
    }

    /// Makes room for at least `extra` more elements without another allocation.
    /// A negative `extra` does nothing.
    pub fn reserve(self: &mut List[T, A], extra: i64) -> void ! AllocErr {
        try self.make_room(extra);
    }

    /// Appends `item`; on failure gives it back.
    pub fn push_or_return(self: &mut List[T, A], item: T) -> void ! AllocFail[
        T,
    ] {
        self.make_room(1) catch e => {
            fail AllocFail[T].{ error: e, value: item };
        };
        unsafe("make_room left ptr[n] inside the block and empty, as n < cap") {
            store(self.ptr, self.n, item);
        }
        self.n += 1;
    }

    /// Inserts `item` at index `i`, shifting the rest up. `i` may equal `len`.
    pub fn insert_or_return(
        self: &mut List[T, A],
        i: i64,
        item: T,
    ) -> void ! AllocFail[T] {
        if i != self.n {
            self.check_index(i);
        }
        self.make_room(1) catch e => {
            fail AllocFail[T].{ error: e, value: item };
        };
        unsafe("0 <= i <= n < cap: ptr[i..n] are live, ptr[n] is empty and ptr[i] is empty once they have moved up") {
            shift_up(self.ptr, i, self.n);
            store(self.ptr, i, item);
        }
        self.n += 1;
    }

    /// Removes and returns the last element, or `.none` when the list is empty.
    pub fn pop(self: &mut List[T, A]) -> ?T {
        if self.n == 0 {
            return .none;
        }
        self.n -= 1;
        unsafe("n was at least 1, so ptr[n - 1] was live, and the length no longer counts it") {
            return .some(load(self.ptr, self.n));
        }
    }

    /// Removes the element at `i` and shifts the rest down.
    pub fn remove(self: &mut List[T, A], i: i64) -> T {
        self.check_index(i);
        unsafe("0 <= i < n: ptr[i] is live and moves out, ptr[i + 1..n] are live and move down, and the length drops by one after") {
            let value = load(self.ptr, i);
            shift_down(self.ptr, i, self.n);
            self.n -= 1;
            return value;
        }
    }

    /// Removes the element at `i` and moves the last element into its place.
    pub fn swap_remove(self: &mut List[T, A], i: i64) -> T {
        self.check_index(i);
        unsafe("0 <= i < n: ptr[i] is live and moves out, ptr[n - 1] is live and moves into the gap unless it is the same slot, and the length drops by one after") {
            let value = load(self.ptr, i);
            let last = self.n - 1;
            if i != last {
                store(self.ptr, i, load(self.ptr, last));
            }
            self.n = last;
            return value;
        }
    }

    pub fn get(self: &List[T, A], i: i64) -> &T from self {
        return &self.items()[i];
    }

    pub fn get_mut(self: &mut List[T, A], i: i64) -> &mut T from self {
        return &mut self.items_mut()[i];
    }

    pub fn items(self: &List[T, A]) -> []T from self {
        unsafe("ptr[0..n] are live, and every call that could move or drop them takes &mut self") {
            return @slice_from_raw(self.ptr as *T, self.n);
        }
    }

    pub fn items_mut(self: &mut List[T, A]) -> []mut T from self {
        unsafe("ptr[0..n] are live, and the exclusive borrow of self keeps every other access away") {
            return @slice_from_raw(self.ptr, self.n);
        }
    }

    /// Consumes the list: `f` receives each element, first to last, then the memory is
    /// freed. The form for a linear `T`.
    pub fn deinit_with[F: FnMut(T)](self: List[T, A], f: F) -> void {
        let List[T, A].{ a, ptr, n, cap } = self;
        var i: i64 = 0;
        while i < n {
            unsafe("ptr[i] is live for i < n, and each slot is moved out once, first to last") {
                f(load(ptr, i));
            }
            i += 1;
        }
        unsafe("ptr is the block of cap slots the list owned, every element has moved out to f, and the list is consumed here") {
            free_block(a, ptr, cap);
        }
    }

    /// Traps (T01) unless `0 <= i < len`, by indexing a slice of the list as the caller
    /// would.
    fn check_index(self: &List[T, A], i: i64) -> void {
        _ = &self.items()[i];
    }

    /// Makes room for `extra` more elements. Nothing happens when `extra <= 0` or the
    /// room is there. Otherwise the capacity becomes the largest of 4, twice the old
    /// capacity and the length needed, and a byte size above 2^62 is `.bad_request`.
    /// Every comparison is made before the arithmetic it guards.
    fn make_room(self: &mut List[T, A], extra: i64) -> void ! AllocErr {
        if extra <= 0 || extra <= self.cap - self.n {
            return;
        }
        let limit = max_elems.[T]();
        // n <= cap <= limit, so the subtraction is safe.
        if extra > limit - self.n {
            fail .bad_request;
        }
        if self.cap > limit / 2 {
            fail .bad_request;
        }
        let need = self.n + extra;
        var new_cap = self.cap * 2;
        if new_cap < 4 {
            new_cap = 4;
        }
        if new_cap < need {
            new_cap = need;
        }
        if new_cap > limit {
            fail .bad_request;
        }
        try self.grow_to(new_cap);
    }

    /// Gives the list room for `new_cap` elements, `new_cap > cap` and at most the
    /// limit: the allocator is asked to resize in place; when it refuses, a new block
    /// is allocated, the elements move to it, and the old block is freed.
    fn grow_to(self: &mut List[T, A], new_cap: i64) -> void ! AllocErr {
        let size = @sizeof(T);
        let align = @alignof(T);
        let old_bytes = self.cap * size;
        let new_bytes = new_cap * size;
        let old = self.ptr as *mut u8;
        if old_bytes > 0 {
            let same_place = unsafe("old is the block of old_bytes this list owns, from this allocator with this align") {
                self.a.resize(old, old_bytes, new_bytes, align)
            };
            if same_place {
                self.cap = new_cap;
                return;
            }
        }
        let block = try self.a.alloc(new_bytes, align);
        let fresh = block as *mut T;
        unsafe("ptr[0..n] are live and fresh is a new block of new_cap > n slots, so the ranges do not overlap") {
            move_all(self.ptr, fresh, self.n);
        }
        unsafe("ptr is the old block of cap slots this list owns, its elements have all moved to fresh, and ptr is replaced right after") {
            free_block(self.a, self.ptr, self.cap);
        }
        self.ptr = fresh;
        self.cap = new_cap;
    }
}

impl[T: Discard, A: Allocator] List[T, A] {
    /// Appends `item`; on failure it is dropped.
    pub fn push(self: &mut List[T, A], item: T) -> void ! AllocErr {
        self.push_or_return(item) catch f => { fail f.error; };
    }

    pub fn insert(self: &mut List[T, A], i: i64, item: T) -> void ! AllocErr {
        self.insert_or_return(i, item) catch f => { fail f.error; };
    }

    /// Drops the elements from index `len` on. A `len` at or above the length does
    /// nothing; a negative one clears the list.
    pub fn truncate(self: &mut List[T, A], len: i64) -> void {
        if len < 0 {
            self.n = 0;
        } else if len < self.n {
            self.n = len;
        }
    }

    pub fn clear(self: &mut List[T, A]) -> void {
        self.n = 0;
    }

    pub fn deinit(self: List[T, A]) -> void {
        let List[T, A].{ a, ptr, n: _, cap } = self;
        unsafe("ptr is the block of cap slots the list owned, its elements are Discard, and the list is consumed here") {
            free_block(a, ptr, cap);
        }
    }
}

impl[T: Copy, A: Allocator] List[T, A] {
    /// Appends a copy of every element of `items`.
    pub fn extend(self: &mut List[T, A], items: []T) -> void ! AllocErr {
        try self.make_room(items.len);
        if @sizeof(T) != 0 {
            var i: i64 = 0;
            while i < items.len {
                unsafe("make_room left room for items.len more slots, so ptr[n + i] is inside the block and empty") {
                    store(self.ptr, self.n + i, items[i]);
                }
                i += 1;
            }
        }
        self.n += items.len;
    }
}

/// `ptr` is behind a raw pointer, so neither property is derived; the list owns its
/// elements as a field would, and `a` is a field.
unsafe impl[T: Send, A: Allocator + Send] Send for List[T, A] {}

unsafe impl[T: Sync, A: Allocator + Sync] Sync for List[T, A] {}

const ok: i64 = 0;
const oom: i64 = 1;
const bad: i64 = 2;

/// What a result is, for the tests: `ok`, `oom` or `bad`.
fn code[T: Discard](r: Result[T, AllocErr]) -> i64 {
    match r {
        .ok(_) => { return ok; }
        .err(e) => {
            if e == .bad_request {
                return bad;
            }
            return oom;
        }
    }
}

/// The same for a `with_capacity`; a list that was made is released.
fn list_code[T: Discard, A: Allocator](r: Result[List[T, A], AllocErr]) -> i64 {
    match r {
        .ok(l) => {
            l.deinit();
            return ok;
        }
        .err(e) => {
            if e == .bad_request {
                return bad;
            }
            return oom;
        }
    }
}

fn is_send[T: Send](x: &T) -> void {}

fn is_sync[T: Sync](x: &T) -> void {}

fn is_owned[T: Owned](x: &T) -> void {}

fn addr[T](p: *mut T) -> i64 {
    return @wrap(i64, p as u64);
}

copy struct Unit {}

struct Pair {
    a: u8,
    b: i64,
}

linear struct Token {
    n: i64,
}

fn tok(n: i64) -> Token {
    return Token.{ n: n };
}

/// Consumes the token and says what it held.
fn spend(t: Token) -> i64 {
    let Token.{ n } = t;
    return n;
}

/// What the failed allocation gave back. A linear value cannot be taken out of an
/// `AllocFail` outside `std.mem` (E1006), so it is read through the field and the
/// failure is forgotten; the token holds a number, so nothing leaks.
fn take_back(f: AllocFail[Token]) -> i64 {
    let n = f.value.n;
    @forget(f);
    return n;
}

fn is_none[T: Discard](o: ?T) -> bool {
    match o {
        .some(_) => { return false; }
        .none => { return true; }
    }
}

fn put[A: Allocator](l: &mut List[Token, A], n: i64) -> void {
    l.push_or_return(tok(n)) catch f => {
        _ = take_back(f);
        @panic("the allocator has memory");
    };
}

/// Pushes `0..n`.
fn count_up[A: Allocator](l: &mut List[i64, A], n: i64) -> void ! AllocErr {
    var i: i64 = 0;
    while i < n {
        try l.push(i);
        i += 1;
    }
}

/// Whether the list holds exactly `0..n`.
fn is_count[A: Allocator](l: &List[i64, A], n: i64) -> bool {
    if l.len() != n {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        if l.items()[i] != i {
            return false;
        }
        i += 1;
    }
    return true;
}

test "an empty list holds nothing and has an aligned, non-null pointer" {
    let heap = @test_env().env.heap;
    var l = List[i64, Heap].init(heap);
    @assert(l.len() == 0);
    @assert(l.capacity() == 0);
    @assert(l.is_empty());
    @assert(l.items().len == 0);
    @assert(l.items_mut().len == 0);
    @assert(is_none(l.pop()));
    @assert(addr(l.ptr) != 0);
    @assert(addr(l.ptr) % 8 == 0);
    l.deinit();

    let p = List[Pair, Heap].init(heap);
    @assert(addr(p.ptr) != 0);
    @assert(addr(p.ptr) % @alignof(Pair) == 0);
    p.deinit();

    let b = List[u8, Heap].init(heap);
    @assert(addr(b.ptr) != 0);
    b.deinit();
}

/// The capacity after pushing `n` elements one at a time onto an empty list: 4, then
/// doubling.
fn doubled_from_4(n: i64) -> i64 {
    var c: i64 = 4;
    while c < n {
        c *= 2;
    }
    return c;
}

test "push and pop through several growths: the capacity is 4, then doubles" {
    let heap = @test_env().env.heap;
    var l = List[i64, Heap].init(heap);
    defer { l.deinit(); }
    var i: i64 = 0;
    while i < 300 {
        try l.push(i * 3);
        i += 1;
        @assert(l.len() == i);
        @assert(l.capacity() == doubled_from_4(i));
    }
    @assert(!l.is_empty());
    @assert(l.capacity() == 512);
    while i > 0 {
        i -= 1;
        @assert(l.items()[i] == i * 3);
        let top = l.pop() orelse -1;
        @assert(top == i * 3);
    }
    @assert(is_none(l.pop()));
    @assert(l.is_empty());
    @assert(l.capacity() == 512);
    // The memory is still there to push into again.
    try l.push(7);
    @assert(l.items()[0] == 7);
}

test "growth keeps the elements when the allocator moves them and when it does not" {
    let heap = @test_env().env.heap;
    // One byte, then eight: a 5-byte malloc block holds 16, so growing to 10 stays put.
    var small = try List[u8, Heap].with_capacity(heap, 5);
    defer { small.deinit(); }
    var i: i64 = 0;
    while i < 5 {
        try small.push(@wrap(u8, i + 1));
        i += 1;
    }
    let before = addr(small.ptr);
    try small.push(6);
    @assert(small.capacity() == 10);
    @assert(addr(small.ptr) == before);
    // Past the block's usable size the heap refuses, and the elements are copied.
    try small.reserve(1000);
    @assert(small.capacity() >= 1006);
    @assert(addr(small.ptr) != 0);
    @assert(small.len() == 6);
    i = 0;
    while i < 6 {
        @assert(small.items()[i] == @wrap(u8, i + 1));
        i += 1;
    }

    // An arena never resizes, so every growth allocates, copies and frees (a no-op).
    let vm = @test_env().env.vm;
    let arena = try Arena.init(vm, (1 << 20));
    defer { arena.deinit(); }
    var l = List[i64, &Arena].init(&arena);
    defer { l.deinit(); }
    try count_up(&mut l, 4);
    @assert(l.capacity() == 4);
    let first = addr(l.ptr);
    try l.push(4);
    @assert(l.capacity() == 8);
    @assert(addr(l.ptr) != first);
    @assert(is_count(&l, 5));
    try count_up(&mut l, 0);
    // 4 elements at 8 bytes, then 8, 16 ... : each block is new, none is reused.
    @assert(arena.used() == 32 + 64);
}

test "with_capacity and reserve" {
    let heap = @test_env().env.heap;
    var l = try List[i64, Heap].with_capacity(heap, 10);
    defer { l.deinit(); }
    @assert(l.len() == 0);
    @assert(l.capacity() == 10);
    try count_up(&mut l, 10);
    @assert(l.capacity() == 10);
    try l.push(10);
    @assert(l.capacity() == 20);
    // Room already there: nothing changes, and a negative or zero request is nothing.
    try l.reserve(9);
    try l.reserve(0);
    try l.reserve(-1);
    try l.reserve(-9223372036854775807 - 1);
    @assert(l.capacity() == 20);
    try l.reserve(10);
    @assert(l.capacity() >= 21);
    // 11 + 100 needed, and twice 20 is less.
    try l.reserve(100);
    @assert(l.capacity() == 111);
    @assert(l.len() == 11);

    let zero = try List[i64, Heap].with_capacity(heap, 0);
    @assert(zero.capacity() == 0);
    zero.deinit();
    // On an empty list `reserve` takes at least 4.
    var e = List[i64, Heap].init(heap);
    defer { e.deinit(); }
    try e.reserve(1);
    @assert(e.capacity() == 4);
    var f = List[i64, Heap].init(heap);
    defer { f.deinit(); }
    try f.reserve(5);
    @assert(f.capacity() == 5);
}

test "with_capacity and reserve reject a bad size as bad_request and leave the list alone" {
    let heap = @test_env().env.heap;
    // 2^59 elements of 8 bytes is exactly 2^62 bytes: allowed, and not available.
    @assert(list_code(List[i64, Heap].with_capacity(heap, -1)) == bad);
    @assert(
        list_code(List[i64, Heap].with_capacity(heap, (1 << 59) + 1)) == bad,
    );
    @assert(list_code(List[i64, Heap].with_capacity(heap, 1 << 62)) == bad);
    @assert(
        list_code(
            List[i64, Heap].with_capacity(heap, 9223372036854775807),
        ) == bad,
    );
    @assert(
        list_code(
            List[i64, Heap].with_capacity(heap, -9223372036854775807 - 1),
        ) == bad,
    );
    @assert(
        list_code(List[u8, Heap].with_capacity(heap, (1 << 62) + 1)) == bad,
    );
    @assert(
        list_code(List[Pair, Heap].with_capacity(heap, (1 << 58) + 1)) == bad,
    );

    var l = List[i64, Heap].init(heap);
    defer { l.deinit(); }
    try count_up(&mut l, 3);
    @assert(code(l.reserve(1 << 59)) == bad);
    @assert(code(l.reserve(1 << 62)) == bad);
    @assert(code(l.reserve(9223372036854775807)) == bad);
    // The need would fit, the sum with the length would overflow.
    @assert(code(l.reserve(9223372036854775807 - 2)) == bad);
    @assert(code(l.reserve((1 << 59) - 2)) == bad);
    // Nothing of that changed the list.
    @assert(l.len() == 3);
    @assert(l.capacity() == 4);
    @assert(is_count(&l, 3));
}

test "insert, remove and swap_remove at the front, the middle and the end" {
    let heap = @test_env().env.heap;
    var l = List[i64, Heap].init(heap);
    defer { l.deinit(); }
    // Insert at the end (== len), the front, and the middle.
    try l.insert(0, 10);
    try l.insert(1, 30);
    try l.insert(0, 5);
    try l.insert(2, 20);
    let a = [4]i64.{ 5, 10, 20, 30 };
    @assert(eq(l.items(), &a[0..4]));
    @assert(l.capacity() == 4);
    // Growing on an insert in the middle keeps the order.
    try l.insert(2, 15);
    let b = [5]i64.{ 5, 10, 15, 20, 30 };
    @assert(eq(l.items(), &b[0..5]));
    @assert(l.capacity() == 8);

    @assert(l.remove(0) == 5);
    @assert(l.remove(1) == 15);
    @assert(l.remove(2) == 30);
    let c = [2]i64.{ 10, 20 };
    @assert(eq(l.items(), &c[0..2]));
    @assert(l.remove(0) == 10);
    @assert(l.remove(0) == 20);
    @assert(l.is_empty());

    try count_up(&mut l, 6);
    // The first, the last (nothing to move) and a middle one.
    @assert(l.swap_remove(0) == 0);
    let d = [5]i64.{ 5, 1, 2, 3, 4 };
    @assert(eq(l.items(), &d[0..5]));
    @assert(l.swap_remove(4) == 4);
    @assert(l.swap_remove(1) == 1);
    let e = [3]i64.{ 5, 3, 2 };
    @assert(eq(l.items(), &e[0..3]));
    @assert(l.swap_remove(0) == 5);
    @assert(l.swap_remove(1) == 3);
    @assert(l.swap_remove(0) == 2);
    @assert(l.is_empty());

    // Remove the only element, and insert into an empty list at 0.
    try l.insert(0, 1);
    @assert(l.remove(0) == 1);
    try l.insert(0, 2);
    @assert(l.swap_remove(0) == 2);
    @assert(l.len() == 0);
}

test "get, get_mut, items and items_mut" {
    let heap = @test_env().env.heap;
    var l = List[i64, Heap].init(heap);
    defer { l.deinit(); }
    try count_up(&mut l, 9);
    @assert(l.get(0).* == 0);
    @assert(l.get(8).* == 8);
    l.get_mut(3).* = 33;
    @assert(l.get(3).* == 33);
    {
        let all = l.items();
        @assert(all.len == 9);
        @assert(all[3] == 33 && all[4] == 4);
    }
    {
        let all = l.items_mut();
        var i: i64 = 0;
        while i < all.len {
            all[i] = all[i] * 2;
            i += 1;
        }
    }
    @assert(l.get(3).* == 66);
    @assert(l.get(8).* == 16);
    @assert(l.len() == 9);
}

test "truncate and clear, with a negative and a too-large length" {
    let heap = @test_env().env.heap;
    var l = List[i64, Heap].init(heap);
    defer { l.deinit(); }
    try count_up(&mut l, 10);
    let cap = l.capacity();
    l.truncate(20);
    @assert(l.len() == 10);
    l.truncate(10);
    @assert(l.len() == 10);
    l.truncate(9223372036854775807);
    @assert(l.len() == 10);
    l.truncate(7);
    @assert(is_count(&l, 7));
    l.truncate(0);
    @assert(l.is_empty());
    try count_up(&mut l, 5);
    l.truncate(-1);
    @assert(l.is_empty());
    try count_up(&mut l, 5);
    l.truncate(-9223372036854775807 - 1);
    @assert(l.is_empty());
    try count_up(&mut l, 5);
    l.clear();
    @assert(l.is_empty());
    l.clear();
    @assert(l.is_empty());
    // The memory is kept.
    @assert(l.capacity() == cap);
    try count_up(&mut l, 3);
    @assert(is_count(&l, 3));
}

test "extend appends copies, grows once, and takes an empty slice" {
    let heap = @test_env().env.heap;
    var l = List[i64, Heap].init(heap);
    defer { l.deinit(); }
    let a = [3]i64.{ 1, 2, 3 };
    try l.extend(&a[0..3]);
    @assert(l.len() == 3);
    @assert(l.capacity() == 4);
    try l.extend(&a[0..0]);
    @assert(l.len() == 3);
    try l.extend(&a[0..3]);
    @assert(l.capacity() == 8);
    let b = [6]i64.{ 1, 2, 3, 1, 2, 3 };
    @assert(eq(l.items(), &b[0..6]));
    // More than twice the capacity at once: the length needed wins.
    var big = List[i64, Heap].init(heap);
    defer { big.deinit(); }
    var src = List[i64, Heap].init(heap);
    defer { src.deinit(); }
    try count_up(&mut src, 100);
    try big.extend(src.items());
    @assert(big.capacity() == 100);
    try big.extend(src.items());
    @assert(big.capacity() == 200);
    @assert(big.len() == 200);
    @assert(big.items()[100] == 0 && big.items()[199] == 99);
    // A copy of a list of bytes.
    var bytes = List[u8, Heap].init(heap);
    defer { bytes.deinit(); }
    try bytes.extend("ingot");
    @assert(eq(bytes.items(), "ingot"));
}

test "a linear element: push_or_return, insert_or_return, pop and deinit_with" {
    let heap = @test_env().env.heap;
    var l = List[Token, Heap].init(heap);
    put(&mut l, 1);
    put(&mut l, 3);
    put(&mut l, 5);
    put(&mut l, 7);
    // Five elements: the list grows by copying linear values.
    put(&mut l, 9);
    l.insert_or_return(1, tok(2)) catch f => {
        _ = take_back(f);
        @panic("the heap has memory");
    };
    l.insert_or_return(3, tok(4)) catch f => {
        _ = take_back(f);
        @panic("the heap has memory");
    };
    l.insert_or_return(0, tok(0)) catch f => {
        _ = take_back(f);
        @panic("the heap has memory");
    };
    l.insert_or_return(8, tok(10)) catch f => {
        _ = take_back(f);
        @panic("the heap has memory");
    };
    // 0 1 2 3 4 5 7 9 10 so far.
    @assert(l.len() == 9);
    @assert(l.get(4).n == 4);
    l.get_mut(4).n = 44;
    @assert(l.items()[4].n == 44);
    @assert(spend(l.remove(4)) == 44);
    // 0 1 2 3 5 7 9 10: remove 3, swap the last into the front.
    @assert(spend(l.remove(3)) == 3);
    @assert(spend(l.swap_remove(0)) == 0);
    // 10 1 2 5 7 9
    @assert(l.len() == 6);
    let last = l.pop() orelse tok(-1);
    @assert(spend(last) == 9);
    // 10 1 2 5 7: every element arrives once, in order.
    var seen: i64 = 0;
    var total: i64 = 0;
    l.deinit_with(
        fn [&mut seen, &mut total](t: Token) -> void {
            let Token.{ n } = t;
            seen.* += 1;
            total.* = total.* * 100 + n;
        },
    );
    @assert(seen == 5);
    @assert(total == 10 * 100000000 + 1 * 1000000 + 2 * 10000 + 5 * 100 + 7);

    // A list that never held anything, and one that was emptied by `pop`.
    let none = List[Token, Heap].init(heap);
    none.deinit_with(
        fn [](t: Token) -> void {
            _ = spend(t);
            @panic("no elements");
        },
    );
    var one = List[Token, Heap].init(heap);
    put(&mut one, 5);
    @assert(spend(one.pop() orelse tok(-1)) == 5);
    match one.pop() {
        .some(t) => {
            _ = spend(t);
            @panic("the list was empty");
        }
        .none => {}
    }
    one.deinit_with(
        fn [](t: Token) -> void {
            _ = spend(t);
            @panic("no elements");
        },
    );
}

test "a linear element in an arena that is full: the value comes back, the list is unchanged" {
    let vm = @test_env().env.vm;
    let arena = try Arena.init(vm, 1);
    defer { arena.deinit(); }
    // Leave room for exactly four tokens: the first growth takes 32 bytes.
    _ = try arena.alloc_slice(arena.capacity() - 32, @wrap(u8, 0));
    var l = List[Token, &Arena].init(&arena);
    put(&mut l, 1);
    put(&mut l, 2);
    put(&mut l, 3);
    put(&mut l, 4);
    @assert(l.capacity() == 4);
    match l.push_or_return(tok(5)) {
        .ok(_) => { @panic("the arena is full"); }
        .err(f) => {
            @assert(f.error == .out_of_memory);
            @assert(take_back(f) == 5);
        }
    }
    match l.insert_or_return(1, tok(6)) {
        .ok(_) => { @panic("the arena is full"); }
        .err(f) => {
            @assert(f.error == .out_of_memory);
            @assert(take_back(f) == 6);
        }
    }
    @assert(l.len() == 4);
    @assert(l.capacity() == 4);
    var next: i64 = 1;
    l.deinit_with(
        fn [&mut next](t: Token) -> void {
            @assert(spend(t) == next.*);
            next.* += 1;
        },
    );
    @assert(next == 5);
}

test "push and insert of a Discard value report out_of_memory when the arena is full" {
    let vm = @test_env().env.vm;
    let arena = try Arena.init(vm, 1);
    defer { arena.deinit(); }
    _ = try arena.alloc_slice(arena.capacity() - 32, @wrap(u8, 0));
    var l = List[i64, &Arena].init(&arena);
    defer { l.deinit(); }
    try count_up(&mut l, 4);
    @assert(code(l.push(4)) == oom);
    @assert(code(l.insert(0, 4)) == oom);
    @assert(code(l.reserve(1)) == oom);
    // Room that is there needs no allocation.
    l.truncate(2);
    @assert(code(l.push(2)) == ok);
    @assert(code(l.insert(0, -1)) == ok);
    @assert(l.len() == 4);
    @assert(l.items()[0] == -1 && l.items()[1] == 0 && l.items()[3] == 2);
    @assert(list_code(List[i64, &Arena].with_capacity(&arena, 1)) == oom);
    // Valid sizes the arena does not have: nothing was taken by the failures.
    l.clear();
    @assert(code(l.reserve(1 << 20)) == oom);
    @assert(code(l.reserve(1 << 58)) == oom);
    @assert(l.capacity() == 4);
    @assert(list_code(List[i64, &Arena].with_capacity(&arena, 1 << 58)) == oom);
    // Exactly 2^62 bytes is a valid request, and the arena does not have it.
    @assert(list_code(List[i64, &Arena].with_capacity(&arena, 1 << 59)) == oom);
}

test "a list of zero-sized elements allocates no bytes and counts to 2^62" {
    let vm = @test_env().env.vm;
    let arena = try Arena.init(vm, 1);
    defer { arena.deinit(); }
    var l = List[Unit, &Arena].init(&arena);
    defer { l.deinit(); }
    var i: i64 = 0;
    while i < 1000 {
        try l.push(Unit.{});
        i += 1;
    }
    @assert(l.len() == 1000);
    @assert(l.capacity() >= 1000);
    @assert(arena.used() == 0);
    @assert(l.items().len == 1000);
    _ = l.get(999);
    _ = l.get_mut(0);
    try l.insert(500, Unit.{});
    _ = l.remove(0);
    _ = l.swap_remove(10);
    @assert(l.len() == 999);
    let u = [3]Unit.{ Unit.{}, Unit.{}, Unit.{} };
    try l.extend(&u[0..3]);
    @assert(l.len() == 1002);
    l.truncate(5);
    @assert(l.len() == 5);
    @assert(!is_none(l.pop()));
    l.clear();
    @assert(is_none(l.pop()));
    @assert(arena.used() == 0);

    let heap = @test_env().env.heap;
    // Zero bytes, so any count up to 2^62 is a valid request, and one more is not.
    let huge = try List[Unit, Heap].with_capacity(heap, 1 << 62);
    @assert(huge.capacity() == (1 << 62));
    huge.deinit();
    @assert(
        list_code(List[Unit, Heap].with_capacity(heap, (1 << 62) + 1)) == bad,
    );
    @assert(list_code(List[void, Heap].with_capacity(heap, -1)) == bad);
    var v = List[void, Heap].init(heap);
    defer { v.deinit(); }
    try v.reserve(1 << 40);
    @assert(v.capacity() == (1 << 40));
    @assert(code(v.reserve((1 << 62) + 1)) == bad);
    @assert(v.capacity() == (1 << 40));
    try v.reserve(1 << 62);
    @assert(v.capacity() == (1 << 62));
    try v.push(unit());
    @assert(v.len() == 1);
    @assert(!is_none(v.pop()));
}

fn unit() -> void {}

test "a zero-sized linear element reaches deinit_with once each" {
    let heap = @test_env().env.heap;
    var l = List[Mark, Heap].init(heap);
    var i: i64 = 0;
    while i < 40 {
        l.push_or_return(Mark.{}) catch f => {
            @forget(f);
            @panic("the heap has memory");
        };
        i += 1;
    }
    var seen: i64 = 0;
    l.deinit_with(
        fn [&mut seen](m: Mark) -> void {
            let Mark.{} = m;
            seen.* += 1;
        },
    );
    @assert(seen == 40);
}

linear struct Mark {}

test "List works with Heap and with &Arena through one body" {
    let heap = @test_env().env.heap;
    try exercise(heap);
    let vm = @test_env().env.vm;
    let arena = try Arena.init(vm, (1 << 24));
    defer { arena.deinit(); }
    try exercise(&arena);
}

fn exercise[A: Allocator](a: A) -> void ! AllocErr {
    var l = List[i64, A].init(a);
    defer { l.deinit(); }
    try count_up(&mut l, 50);
    @assert(is_count(&l, 50));
    try l.insert(25, -1);
    @assert(l.remove(25) == -1);
    @assert(l.swap_remove(0) == 0);
    @assert(l.items()[0] == 49 && l.len() == 49);
    var s = try List[Pair, A].with_capacity(a, 3);
    defer { s.deinit(); }
    var i: i64 = 0;
    while i < 20 {
        try s.push(Pair.{ a: @wrap(u8, i), b: i * 1000 });
        i += 1;
    }
    @assert(s.len() == 20);
    @assert(s.get(19).a == 19 && s.get(19).b == 19000);
    @assert(s.get(0).a == 0 && s.get(7).b == 7000);
}

test "List is Send, Sync and Owned when its element and allocator are" {
    let heap = @test_env().env.heap;
    let l = List[i64, Heap].init(heap);
    is_send(&l);
    is_sync(&l);
    is_owned(&l);
    l.deinit();
    let t = List[Token, Heap].init(heap);
    is_send(&t);
    is_sync(&t);
    is_owned(&t);
    t.deinit_with(fn [](x: Token) -> void { _ = spend(x); });
}

/// An allocator that holds a list to the `Allocator` contract: `free` is only for blocks
/// that `alloc` gave, so it must never see the list's own `dangling` pointer. A list
/// never gives back a block of no bytes, which is the case to catch.
copy struct Strict {
    h: Heap,
}

impl Allocator for Strict {
    fn alloc(self: Strict, size: i64, align: i64) -> *mut u8 ! AllocErr {
        return try self.h.alloc(size, align);
    }

    unsafe fn free(self: Strict, ptr: *mut u8, size: i64, align: i64) {
        @assert(size > 0);
        unsafe("the caller's precondition: ptr came from self.h with this size and align") {
            self.h.free(ptr, size, align);
        }
    }

    unsafe fn resize(
        self: Strict,
        ptr: *mut u8,
        old: i64,
        new: i64,
        align: i64,
    ) -> bool {
        return false;
    }
}

test "a list gives its allocator back only blocks the allocator gave" {
    let strict = Strict.{ h: @test_env().env.heap };
    // Never allocated: `deinit` and `deinit_with` free nothing.
    let a = List[i64, Strict].init(strict);
    a.deinit();
    let b = List[Token, Strict].init(strict);
    b.deinit_with(fn [](t: Token) -> void { _ = spend(t); });
    // The first growth replaces the `dangling` pointer without freeing it.
    var c = List[i64, Strict].init(strict);
    defer { c.deinit(); }
    try count_up(&mut c, 9);
    @assert(is_count(&c, 9));
    // Zero-sized elements never have a block of bytes.
    var d = List[Unit, Strict].init(strict);
    defer { d.deinit(); }
    try d.push(Unit.{});
    try d.reserve(100);
    let e = try List[i64, Strict].with_capacity(strict, 0);
    e.deinit();
}
