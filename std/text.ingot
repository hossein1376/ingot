//! UTF-8 and ASCII text operations.
//!
//! Slices are bytes. Decoding is explicit and never assumes the input is valid.

/// Why a UTF-8 slice could not be decoded.
pub enum Utf8Err {
    invalid_start: u8,
    truncated,
    overlong,
    surrogate,
    out_of_range,
    bad_continuation: u8,
}

/// Why an integer literal could not be parsed.
pub enum ParseIntErr {
    empty,
    sign_only,
    bad_digit: u8,
    overflow,
    negative,
}

/// Why a boolean literal could not be parsed.
pub enum ParseBoolErr {
    empty,
    invalid,
}

/// The width of the UTF-8 sequence starting with `first`, or 0 when the byte
/// cannot start a sequence.
pub fn sequence_len(first: u8) -> i64 {
    if first < 0x80 {
        return 1;
    }
    if first >= 0xc2 && first <= 0xdf {
        return 2;
    }
    if first >= 0xe0 && first <= 0xef {
        return 3;
    }
    if first >= 0xf0 && first <= 0xf4 {
        return 4;
    }
    return 0;
}

/// Reports whether `s` is well-formed UTF-8.
pub fn valid(s: []u8) -> bool {
    var i: i64 = 0;
    while i < s.len {
        let b = s[i];
        let width = sequence_len(b);
        if width == 0 {
            return false;
        }
        if i + width > s.len {
            return false;
        }
        if width == 2 && b < 0xc2 {
            return false;
        }
        if width == 3 {
            let b1 = s[i + 1];
            if b == 0xe0 && b1 < 0xa0 {
                return false;
            }
            if b == 0xed && b1 >= 0xa0 {
                return false;
            }
        }
        if width == 4 {
            let b1 = s[i + 1];
            if b == 0xf0 && b1 < 0x90 {
                return false;
            }
            if b == 0xf4 && b1 > 0x8f {
                return false;
            }
        }
        var j: i64 = 1;
        while j < width {
            if (s[i + j] & 0xc0) != 0x80 {
                return false;
            }
            j += 1;
        }
        i += width;
    }
    return true;
}

/// Counts Unicode scalar values after validating the input.
pub fn count(s: []u8) -> i64 ! Utf8Err {
    var i: i64 = 0;
    var n: i64 = 0;
    while i < s.len {
        let b = s[i];
        let width = sequence_len(b);
        if width == 0 {
            fail .invalid_start(b);
        }
        if i + width > s.len {
            fail .truncated;
        }
        if width == 3 {
            let b1 = s[i + 1];
            if b == 0xe0 && b1 < 0xa0 {
                fail .overlong;
            }
            if b == 0xed && b1 >= 0xa0 {
                fail .surrogate;
            }
        }
        if width == 4 {
            let b1 = s[i + 1];
            if b == 0xf0 && b1 < 0x90 {
                fail .overlong;
            }
            if b == 0xf4 && b1 > 0x8f {
                fail .out_of_range;
            }
        }
        var j: i64 = 1;
        while j < width {
            let c = s[i + j];
            if (c & 0xc0) != 0x80 {
                fail .bad_continuation(c);
            }
            j += 1;
        }
        i += width;
        n += 1;
    }
    return n;
}

/// The first index of `needle`, or `.none`.
pub fn find_byte(s: []u8, needle: u8) -> ?i64 {
    for i in 0..s.len {
        if s[i] == needle {
            return .some(i);
        }
    }
    return .none;
}

pub fn starts_with(s: []u8, prefix: []u8) -> bool {
    if prefix.len > s.len {
        return false;
    }
    for i in 0..prefix.len {
        if s[i] != prefix[i] {
            return false;
        }
    }
    return true;
}

pub fn ends_with(s: []u8, suffix: []u8) -> bool {
    if suffix.len > s.len {
        return false;
    }
    for i in 0..suffix.len {
        if s[s.len - suffix.len + i] != suffix[i] {
            return false;
        }
    }
    return true;
}

fn is_space(b: u8) -> bool {
    return b == ' ' || b == '\t' || b == '\n' || b == '\r';
}

/// Trims ASCII whitespace from both ends of `s`.
pub fn trim(s: []u8) -> []u8 from s {
    var lo: i64 = 0;
    var hi: i64 = s.len;
    while lo < hi && is_space(s[lo]) {
        lo += 1;
    }
    while hi > lo && is_space(s[hi - 1]) {
        hi -= 1;
    }
    return s[lo..hi];
}

/// Parses a base-10 `i64`. The `i64` minimum is accepted.
pub fn parse_i64(s: []u8) -> i64 ! ParseIntErr {
    if s.len == 0 {
        fail .empty;
    }
    var i: i64 = 0;
    var negative = false;
    if s[0] == '-' {
        negative = true;
        i = 1;
    } else if s[0] == '+' {
        i = 1;
    }
    if i == s.len {
        fail .sign_only;
    }
    let limit: u64 = if negative { 9223372036854775808 } else { 9223372036854775807 };
    var acc: u64 = 0;
    while i < s.len {
        let c = s[i];
        if c < '0' || c > '9' {
            fail .bad_digit(c);
        }
        let d: u64 = @narrow(u64, c - '0');
        if acc > (limit - d) / 10 {
            fail .overflow;
        }
        acc = acc * 10 + d;
        i += 1;
    }
    if negative {
        if acc == 9223372036854775808 {
            return -9223372036854775807 - 1;
        }
        let magnitude: i64 = @narrow(i64, acc);
        return -magnitude;
    }
    return @narrow(i64, acc);
}

/// Parses a base-10 `u64`. A leading `+` is accepted.
pub fn parse_u64(s: []u8) -> u64 ! ParseIntErr {
    if s.len == 0 {
        fail .empty;
    }
    var i: i64 = 0;
    if s[0] == '+' {
        i = 1;
    } else if s[0] == '-' {
        fail .negative;
    }
    if i == s.len {
        fail .sign_only;
    }
    var acc: u64 = 0;
    while i < s.len {
        let c = s[i];
        if c < '0' || c > '9' {
            fail .bad_digit(c);
        }
        let d: u64 = @narrow(u64, c - '0');
        if acc > (18446744073709551615 - d) / 10 {
            fail .overflow;
        }
        acc = acc * 10 + d;
        i += 1;
    }
    return acc;
}

fn hex_digit(c: u8) -> u8 {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 255;
}

/// Parses hexadecimal digits, with an optional `0x` or `0X` prefix.
pub fn parse_hex_u64(s: []u8) -> u64 ! ParseIntErr {
    if s.len == 0 {
        fail .empty;
    }
    var i: i64 = 0;
    if s.len >= 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {
        i = 2;
    }
    if i == s.len {
        fail .sign_only;
    }
    var acc: u64 = 0;
    while i < s.len {
        let d = hex_digit(s[i]);
        if d == 255 {
            fail .bad_digit(s[i]);
        }
        let v: u64 = @narrow(u64, d);
        if acc > (18446744073709551615 - v) / 16 {
            fail .overflow;
        }
        acc = acc * 16 + v;
        i += 1;
    }
    return acc;
}

/// Parses `true`, `false`, `1` or `0`.
pub fn parse_bool(s: []u8) -> bool ! ParseBoolErr {
    if s.len == 0 {
        fail .empty;
    }
    if s.len == 4 && s[0] == 't' && s[1] == 'r' && s[2] == 'u' && s[3] == 'e' {
        return true;
    }
    if s.len == 5 && s[0] == 'f' && s[1] == 'a' && s[2] == 'l' && s[3] == 's' && s[4] == 'e' {
        return false;
    }
    if s.len == 1 && s[0] == '1' {
        return true;
    }
    if s.len == 1 && s[0] == '0' {
        return false;
    }
    fail .invalid;
}

fn ascii_lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' {
        return c + 32;
    }
    return c;
}

/// Compares ASCII letters without case.
pub fn eq_ignore_ascii_case(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if ascii_lower(a[i]) != ascii_lower(b[i]) {
            return false;
        }
    }
    return true;
}
