//! macOS system calls used by the runtime and the layers above it.
//!
//! These declarations are the raw boundary. Every caller states why the
//! pointer and length are valid in an `unsafe("...")` block.

extern "C" {
    fn read(fd: i32, buf: *mut u8, count: i64) -> i64;
    fn write(fd: i32, buf: *u8, count: i64) -> i64;
    fn open(path: *u8, flags: i32, mode: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn mmap(addr: *mut u8, len: i64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut u8;
    fn munmap(addr: *mut u8, len: i64) -> i32;
    fn exit(code: i32) -> never;
}
