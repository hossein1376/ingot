//! macOS system calls used by the runtime and the layers above it.
//!
//! These declarations are the raw boundary. Every caller states why the
//! pointer and length are valid in an `unsafe("...")` block.

pub const o_rdonly: i32 = 0;
pub const o_wronly: i32 = 1;
pub const o_rdwr: i32 = 2;
pub const o_append: i32 = 8;
pub const o_creat: i32 = 512;
pub const o_trunc: i32 = 1024;
pub const eintr: i32 = 4;

extern "C" {
    fn read(fd: i32, buf: *mut u8, count: i64) -> i64;
    fn write(fd: i32, buf: *u8, count: i64) -> i64;
    fn open(path: *u8, flags: i32, mode: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn mmap(addr: *mut u8, len: i64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut u8;
    fn munmap(addr: *mut u8, len: i64) -> i32;
    fn exit(code: i32) -> never;
}

/// Reads into `out`. Returns the byte count, or a negative errno.
pub unsafe fn read_into(fd: i32, out: []mut u8) -> i64 {
    return unsafe("out owns out.len writable bytes") {
        read(fd, out.ptr, out.len)
    };
}

/// Writes `bytes`. Returns the byte count, or a negative errno.
pub unsafe fn write_once(fd: i32, bytes: []u8) -> i64 {
    return unsafe("bytes owns bytes.len readable bytes") {
        write(fd, bytes.ptr, bytes.len)
    };
}
