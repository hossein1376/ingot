//! In-place sorting for scalar slices.
//!
//! These are the allocation-free primitives. Generic sorting arrives with
//! interface method resolution for type parameters.

/// Sorts `xs` in ascending order.
pub fn sort_i64(xs: []mut i64) {
    var i: i64 = 1;
    while i < xs.len {
        let key = xs[i];
        var j = i;
        while j > 0 && xs[j - 1] > key {
            xs[j] = xs[j - 1];
            j -= 1;
        }
        xs[j] = key;
        i += 1;
    }
}

/// Sorts `xs` in ascending order.
pub fn sort_u64(xs: []mut u64) {
    var i: i64 = 1;
    while i < xs.len {
        let key = xs[i];
        var j = i;
        while j > 0 && xs[j - 1] > key {
            xs[j] = xs[j - 1];
            j -= 1;
        }
        xs[j] = key;
        i += 1;
    }
}

pub fn is_sorted_i64(xs: []i64) -> bool {
    var i: i64 = 1;
    while i < xs.len {
        if xs[i - 1] > xs[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

/// The lowest index whose value is not less than `needle`.
pub fn lower_bound_i64(xs: []i64, needle: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = xs.len;
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if xs[mid] < needle {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// Finds `needle` in a sorted slice.
pub fn binary_search_i64(xs: []i64, needle: i64) -> ?i64 {
    let i = lower_bound_i64(xs, needle);
    if i < xs.len && xs[i] == needle {
        return .some(i);
    }
    return .none;
}
