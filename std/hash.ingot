//! Stable non-cryptographic hashing.
//!
//! FNV-1a is the byte hash. `mix_u64` is the SplitMix64 finalizer; it gives
//! good avalanche for integer keys and hash-combine.

/// FNV-1a over bytes, 64-bit.
pub fn fnv1a(bytes: []u8) -> u64 {
    var h: u64 = 14695981039346656037;
    var i: i64 = 0;
    while i < bytes.len {
        let b = bytes[i];
        let v: u64 = @narrow(u64, b);
        h ^= v;
        h *%= 1099511628211;
        i += 1;
    }
    return h;
}

/// The SplitMix64 finalizer.
pub fn mix_u64(value: u64) -> u64 {
    var x = value;
    x ^= x >> 30;
    x *%= 0xbf58476d1ce4e5b9;
    x ^= x >> 27;
    x *%= 0x94d049bb133111eb;
    x ^= x >> 31;
    return x;
}

/// Hashes a signed integer by its bit pattern.
pub fn hash_i64(value: i64) -> u64 {
    return mix_u64(@bits(u64, value));
}

/// Hashes a float by its bit pattern.
pub fn hash_f64(value: f64) -> u64 {
    return mix_u64(@bits(u64, value));
}

/// Combines two hashes without XOR symmetry.
pub fn combine(a: u64, b: u64) -> u64 {
    let mixed = mix_u64(b);
    return mix_u64(a ^ mixed);
}
