//! The standard library root: the process environment and its capabilities.
//!
//! An `Env` can only be produced by the runtime. Every field is a capability
//! that safe code can use but cannot construct.

import std.fs;
import std.io;
import std.mem;
import std.net;
import std.time;

/// Environment variables, read-only after process start.
pub struct Vars {
    private: bool,
}

/// Operating-system entropy.
pub struct Rand {
    private: bool,
}

/// Everything `main` is given. The runtime hands out the only value.
pub struct Env {
    pub args: [][]u8,
    pub vars: &Vars,
    pub heap: mem.Heap,
    pub vm: mem.Vm,
    pub fs: &fs.Fs,
    pub net: &net.Net,
    pub clock: &time.Clock,
    pub rand: &Rand,
    pub stdin: &io.Reader,
    pub stdout: &io.Writer,
    pub stderr: &io.Writer,
    private: bool,
}
