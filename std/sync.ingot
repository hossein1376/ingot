// std.sync (spec sections 13.6, 20, 21 and 35). "Contents are `Owned`": a type with
// interior mutability holds no borrow.

import std.sys.rt;

/// The cell of section 13.6: the one language item whose contents may be written
/// through a shared borrow, in `unsafe` (section 15).
pub struct Cell[T: Owned] {
    value: T,
}

impl[T: Owned] Cell[T] {
    pub fn init(value: T) -> Cell[T] {
        return Cell[T].{ value: value };
    }

    /// A raw pointer to the contents. Safe to make; every use of it is `unsafe`
    /// (section 15).
    pub fn get(self: &Cell[T]) -> *mut T {
        return &self.value as *T as *mut T;
    }

    pub fn into_inner(self: Cell[T]) -> T {
        return self.value;
    }
}

/// The orders of each operation, as three types so that an order the operation does
/// not allow cannot be written (section 15).
pub copy enum LoadOrder: u8 {
    relaxed,
    acquire,
    seq_cst,
}

pub copy enum StoreOrder: u8 {
    relaxed,
    release,
    seq_cst,
}

pub copy enum AtomicOrder: u8 {
    relaxed,
    acquire,
    release,
    acq_rel,
    seq_cst,
}

/// A value that may be read and written through `&self` by a single instruction.
pub struct Atomic[T: AtomicValue] {
    value: Cell[T],
}

impl[T: AtomicValue] Atomic[T] {
    pub fn init(value: T) -> Atomic[T] {
        return Atomic[T].{ value: Cell[T].init(value) };
    }

    pub inline fn load(self: &Atomic[T], order: LoadOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_load(self.value.get(), order);
        }
    }

    pub inline fn store(self: &Atomic[T], value: T, order: StoreOrder) -> void {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            @atomic_store(self.value.get(), value, order);
        }
    }

    pub inline fn swap(self: &Atomic[T], value: T, order: AtomicOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_swap(self.value.get(), value, order);
        }
    }

    /// Success gives the previous value; failure also gives the observed value, so the
    /// caller can retry without a second load.
    pub inline fn compare_exchange(
        self: &Atomic[T],
        expected: T,
        new: T,
        success: AtomicOrder,
        failure: LoadOrder,
    ) -> T ! T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return try @atomic_cmpxchg(
                self.value.get(),
                expected,
                new,
                success,
                failure,
            );
        }
    }

    pub inline fn compare_exchange_weak(
        self: &Atomic[T],
        expected: T,
        new: T,
        success: AtomicOrder,
        failure: LoadOrder,
    ) -> T ! T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return try @atomic_cmpxchg_weak(
                self.value.get(),
                expected,
                new,
                success,
                failure,
            );
        }
    }

    pub fn get_mut(self: &mut Atomic[T]) -> &mut T from self {
        return &mut self.value.value;
    }

    pub fn into_inner(self: Atomic[T]) -> T {
        return self.value.into_inner();
    }
}

impl[T: AtomicValue + Int] Atomic[T] {
    /// Wrapping addition, as the hardware does. Gives the previous value.
    pub inline fn add(self: &Atomic[T], delta: T, order: AtomicOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_add(self.value.get(), delta, order);
        }
    }

    pub inline fn sub(self: &Atomic[T], delta: T, order: AtomicOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_sub(self.value.get(), delta, order);
        }
    }

    pub inline fn and(self: &Atomic[T], mask: T, order: AtomicOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_and(self.value.get(), mask, order);
        }
    }

    pub inline fn or(self: &Atomic[T], mask: T, order: AtomicOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_or(self.value.get(), mask, order);
        }
    }

    pub inline fn xor(self: &Atomic[T], mask: T, order: AtomicOrder) -> T {
        unsafe("the cell holds a live, aligned T for the whole borrow of self") {
            return @atomic_xor(self.value.get(), mask, order);
        }
    }
}

/// A lock around a `T`: `state` is 0 while the lock is free and 1 while a guard holds it.
/// While state is 1, the holder's guard is the only borrow of the cell's contents.
pub struct Mutex[T: Owned] {
    cell: Cell[T],
    state: Atomic[u8],
}

impl[T: Owned] Mutex[T] {
    pub fn init(value: T) -> Mutex[T] {
        return Mutex[T].{
            cell: Cell[T].init(value),
            state: Atomic[u8].init(0),
        };
    }

    /// Takes the lock, waiting for it. While it is held, the wait runs one pending record
    /// of the current task's scopes (`rt.run_pending`), and when there is none the program
    /// traps T13. Does not observe cancellation (section 22).
    ///
    /// Why this is the stage 1 wait (docs/std/sched.md): one task runs at a time, and a
    /// task that holds a guard has not finished, so it is on this stack: this task, or one
    /// further down. Such a holder cannot finish before this call returns, so running a
    /// pending record cannot release the lock. The loop runs the records anyway, because
    /// the runtime promises that other pending work runs before T13. A later stage can
    /// park the task here instead.
    pub fn lock(self: &Mutex[T]) -> Guard[T] from self {
        while !self.try_take() {
            if !rt.run_pending() {
                rt.deadlock_trap();
            }
        }
        return self.guard();
    }

    /// Takes the lock if it is free. Gives `.none`, without waiting, while it is held.
    pub fn try_lock(self: &Mutex[T]) -> ?Guard[T] from self {
        if self.try_take() {
            return .some(self.guard());
        }
        return .none;
    }

    pub fn get_mut(self: &mut Mutex[T]) -> &mut T from self {
        return &mut self.cell.value;
    }

    pub fn into_inner(self: Mutex[T]) -> T {
        let Mutex[T].{ cell, state: _ } = self;
        return cell.into_inner();
    }

    /// One attempt, which changes state from 0 to 1 or changes nothing. The success order
    /// is acquire, so the writes of the holder that released the lock are visible here.
    fn try_take(self: &Mutex[T]) -> bool {
        match self.state.compare_exchange(0, 1, .acquire, .relaxed) {
            .ok(_) => { return true; }
            .err(_) => { return false; }
        }
    }

    /// The guard of a lock this task has just taken.
    fn guard(self: &Mutex[T]) -> Guard[T] from self {
        let value = unsafe("state is 1 and the caller has just taken the lock, so the guard is the only borrow of the cell's contents until unlock") {
            @borrow_from_raw(self.cell.get())
        };
        return Guard[T].{ mutex: self, value: value, not_send: [0]*u8.{} };
    }
}

impl[T: Discard + Owned] Mutex[T] {
    /// Ends the lock. Nothing is freed: the state is one byte, and `T` is `Discard`.
    pub fn deinit(self: Mutex[T]) -> void {
        let Mutex[T].{ cell: _, state: _ } = self;
    }
}

/// A linear view of a held lock: `unlock` is the only way to release it. The `[0]*u8`
/// field makes it not `Send`, because the language cannot say "not `Send`".
pub linear struct Guard[T: Owned] {
    mutex: &Mutex[T],
    value: &mut T,
    not_send: [0]*u8,
}

impl[T: Owned] Guard[T] {
    pub fn get(self: &mut Guard[T]) -> &mut T from self {
        return &mut self.value.*;
    }

    /// Releases the lock. The store is a release, so the next holder's acquire sees every
    /// write made through this guard.
    pub fn unlock(self: Guard[T]) -> void {
        let Guard[T].{ mutex, value: _, not_send: _ } = self;
        mutex.state.store(0, .release);
    }
}

// The guard is `Sync` when `T` is `Send` and `Sync`, as sync.md section 8 says. A `&Guard`
// gives only `&Mutex` (which is `Sync` for `T: Send`) and shared reads of the `T` behind
// `value` (which `T: Sync` allows). The contents change only through `get` and `unlock`,
// and both take the guard by `&mut` or by value.
unsafe impl[T: Owned + Send + Sync] Sync for Guard[T] {}

// Section 20: `Atomic[T]` and `Mutex[T]` are `Send` and `Sync` when `T: Send`. These
// rows are given with `unsafe impl` (section 20) rather than derived from the fields:
// `Atomic` holds a `Cell`, which is never `Sync`, and the table's row is the rule.
unsafe impl[T: AtomicValue + Send] Send for Atomic[T] {}

unsafe impl[T: AtomicValue + Send] Sync for Atomic[T] {}

unsafe impl[T: Owned + Send] Send for Mutex[T] {}

unsafe impl[T: Owned + Send] Sync for Mutex[T] {}

static test_counter: Atomic[i64] = Atomic[i64].init(0);

noinline fn add_with(a: &Atomic[i64], delta: i64, order: AtomicOrder) -> i64 {
    return a.add(delta, order);
}

noinline fn load_with(a: &Atomic[i64], order: LoadOrder) -> i64 {
    return a.load(order);
}

noinline fn exchange_with(
    a: &Atomic[i64],
    expected: i64,
    new: i64,
    success: AtomicOrder,
    failure: LoadOrder,
) -> i64 ! i64 {
    return try a.compare_exchange(expected, new, success, failure);
}

test "load, store, swap and the read-modify-write operations give the previous value" {
    let a = Atomic[i64].init(5);
    @assert(a.load(.relaxed) == 5);
    a.store(7, .release);
    @assert(a.load(.acquire) == 7);
    @assert(a.swap(9, .acq_rel) == 7);
    @assert(a.add(3, .relaxed) == 9);
    @assert(a.sub(2, .seq_cst) == 12);
    @assert(a.and(6, .relaxed) == 10);
    @assert(a.or(5, .relaxed) == 2);
    @assert(a.xor(2, .relaxed) == 7);
    @assert(a.into_inner() == 5);
}

test "add and sub wrap" {
    let a = Atomic[u8].init(250);
    @assert(a.add(10, .relaxed) == 250);
    @assert(a.load(.relaxed) == 4);
    @assert(a.sub(5, .relaxed) == 4);
    @assert(a.load(.relaxed) == 255);
    let b = Atomic[i64].init(9223372036854775807);
    @assert(b.add(1, .relaxed) == 9223372036854775807);
    @assert(b.load(.relaxed) == -9223372036854775808);
}

test "bool, a raw pointer and a payload-free enum are atomic values" {
    let flag = Atomic[bool].init(false);
    @assert(!flag.swap(true, .seq_cst));
    @assert(flag.load(.relaxed));

    var x: i64 = 1;
    var y: i64 = 2;
    let px = &mut x as *mut i64;
    let py = &mut y as *mut i64;
    let p = Atomic[*mut i64].init(px);
    @assert(p.swap(py, .acq_rel) == px);
    @assert(p.load(.acquire) == py);

    let order = Atomic[LoadOrder].init(.relaxed);
    order.store(.seq_cst, .seq_cst);
    @assert(order.load(.relaxed) == .seq_cst);
}

test "compare_exchange gives the previous value, or the observed one as the error" {
    let a = Atomic[i64].init(10);
    match a.compare_exchange(10, 20, .seq_cst, .relaxed) {
        .ok(previous) => { @assert(previous == 10); }
        .err(_) => { @assert(false); }
    }
    match a.compare_exchange(10, 30, .acq_rel, .seq_cst) {
        .ok(_) => { @assert(false); }
        .err(observed) => { @assert(observed == 20); }
    }
    @assert(a.load(.relaxed) == 20);
}

test "compare_exchange_weak in a retry loop" {
    let a = Atomic[i64].init(3);
    var seen = a.load(.relaxed);
    var done = false;
    while !done {
        match a.compare_exchange_weak(seen, seen * 2, .acq_rel, .relaxed) {
            .ok(_) => { done = true; }
            .err(now) => { seen = now; }
        }
    }
    @assert(a.load(.relaxed) == 6);
}

test "an order that is a parameter takes each of its values" {
    let a = Atomic[i64].init(0);
    @assert(add_with(&a, 1, .relaxed) == 0);
    @assert(add_with(&a, 2, .acquire) == 1);
    @assert(add_with(&a, 4, .release) == 3);
    @assert(add_with(&a, 8, .acq_rel) == 7);
    @assert(add_with(&a, 16, .seq_cst) == 15);
    @assert(load_with(&a, .relaxed) == 31);
    @assert(load_with(&a, .acquire) == 31);
    @assert(load_with(&a, .seq_cst) == 31);
    match exchange_with(&a, 31, 32, .release, .seq_cst) {
        .ok(previous) => { @assert(previous == 31); }
        .err(_) => { @assert(false); }
    }
    match exchange_with(&a, 31, 0, .seq_cst, .acquire) {
        .ok(_) => { @assert(false); }
        .err(observed) => { @assert(observed == 32); }
    }
}

test "a fence takes any order" {
    @fence(.relaxed);
    @fence(.acquire);
    @fence(.release);
    @fence(.acq_rel);
    @fence(.seq_cst);
}

test "a static atomic is one counter for the whole program" {
    var i: i64 = 0;
    while i < 100 {
        _ = test_counter.add(1, .relaxed);
        i += 1;
    }
    @assert(test_counter.load(.relaxed) == 100);
}

test "get_mut and Cell" {
    var a = Atomic[i64].init(1);
    let m = a.get_mut();
    m.* = 2;
    @assert(a.load(.relaxed) == 2);
    let c = Cell[i64].init(4);
    let p = c.get();
    unsafe("p points at the cell's contents, which nothing else borrows") {
        p.* += 1;
    }
    @assert(c.into_inner() == 5);
}

struct Pair {
    a: i64,
    b: i64,
}

fn bump(m: &Mutex[i64]) -> void {
    var g = m.lock();
    let n = g.get();
    n.* += 1;
    g.unlock();
}

fn shift(m: &Mutex[Pair]) -> void {
    var g = m.lock();
    let p = g.get();
    p.a += 1;
    p.b -= 1;
    g.unlock();
}

test "lock, write through get, unlock, lock again and read" {
    let m = Mutex[i64].init(10);
    var g = m.lock();
    let v = g.get();
    v.* = 20;
    g.unlock();
    var h = m.lock();
    @assert(h.get().* == 20);
    h.unlock();
    m.deinit();
}

test "try_lock gives none while a guard is held, and a guard after unlock" {
    let m = Mutex[i64].init(1);
    let g = m.lock();
    match m.try_lock() {
        .some(other) => {
            other.unlock();
            @assert(false);
        }
        .none => {}
    }
    g.unlock();
    match m.try_lock() {
        .some(again) => { again.unlock(); }
        .none => { @assert(false); }
    }
    m.deinit();
}

test "get_mut and into_inner give the contents" {
    var m = Mutex[i64].init(4);
    let v = m.get_mut();
    v.* += 1;
    @assert(m.into_inner() == 5);
}

test "a struct is the contents of a lock, and deinit drops it" {
    let m = Mutex[Pair].init(Pair.{ a: 1, b: 2 });
    shift(&m);
    var g = m.lock();
    let p = g.get();
    @assert(p.a == 2 && p.b == 1);
    g.unlock();
    m.deinit();
}

test "tasks of one scope each lock, add and unlock" {
    let m = Mutex[i64].init(0);
    scope s {
        var i: i64 = 0;
        while i < 10 {
            spawn bump(&m) in s;
            i += 1;
        }
    }
    @assert(m.into_inner() == 10);
}

test "tasks of one scope share a Mutex of a struct" {
    let m = Mutex[Pair].init(Pair.{ a: 0, b: 0 });
    scope s {
        var i: i64 = 0;
        while i < 5 {
            spawn shift(&m) in s;
            i += 1;
        }
    }
    let p = m.into_inner();
    @assert(p.a == 5 && p.b == -5);
}
