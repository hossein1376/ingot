pub struct Counter { value: i64 }

impl Counter {
    pub fn make(start: i64) -> Counter {
        return Counter.{ value: start };
    }

    pub fn bump(self: &mut Counter) {
        self.value += 1;
    }

    pub fn get(self: &Counter) -> i64 {
        return self.value;
    }
}

pub const limit: i64 = 10;

pub fn add(a: i64, b: i64) -> i64 {
    return a + b;
}
